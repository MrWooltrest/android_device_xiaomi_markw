on init
    # IR
    chown system system /sys/class/leds/infrared/transmit
    chown system system /sys/class/leds/infrared/brightness

on post-fs-data
    # Create folder for mm-qcamera-daemon
    mkdir /data/vendor/qcam/ 0770 camera camera

# Fingerprint
service vendor.goodix_script /vendor/bin/init.goodix.sh
    class late_start
    user system
    group system
    oneshot

# USB
on property:ro.product.vendor.model=*
    setprop vendor.usb.product_string ${ro.product.vendor.model}
